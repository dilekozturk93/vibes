digraph SVM_FTS {
  rankdir=LR;
  graph [bgcolor="transparent", margin=0.1];
  node [shape=circle, fixedsize=true, width=0.55, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9];

  start [shape=point, width=0.08];
  s1 [label="1"];
  s2 [label="2"];
  s3 [label="3"];
  s4 [label="4"];
  s5 [label="5"];
  s6 [label="6"];
  s7 [label="7"];
  s8 [label="8"];
  s9 [label="9"];

  start -> s1;

  s1 -> s2 [label="pay / !FreeDrinks"];
  s2 -> s3 [label="change / !FreeDrinks"];
  s1 -> s3 [label="free / FreeDrinks"];

  s3 -> s4 [label="cancel / CancelPurchase"];
  s4 -> s1 [label="return / CancelPurchase"];

  s3 -> s5 [label="soda / Soda"];
  s5 -> s7 [label="serveSoda / Soda"];

  s3 -> s6 [label="tea / Tea"];
  s6 -> s7 [label="serveTea / Tea"];

  s7 -> s1 [label="take / FreeDrinks"];
  s7 -> s8 [label="open / !FreeDrinks"];
  s8 -> s9 [label="take / !FreeDrinks"];
  s9 -> s1 [label="close / !FreeDrinks"];
}
